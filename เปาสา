-- ฟังก์ชันพยายามค้นหาและใช้งาน RemoteEvent ในเกม
local function getBoomboxRemote()
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("boombox") or v.Name:lower():find("music") or v.Name:lower():find("song") or v.Name:lower():find("play")) then
            return v
        end
    end
    return nil
end

-- ปุ่มกดเล่น
playButton.MouseButton1Click:Connect(function()
    local musicId = textBox.Text
    if musicId ~= "" then
        local remote = getBoomboxRemote()
        if remote then
            -- ถ้าเกมมีรีโมทเพลง จะส่งค่าไปที่ Server เพื่อให้คนอื่นได้ยิน
            pcall(function()
                remote:FireServer(musicId)
            end)
            pcall(function()
                remote:FireServer("Play", musicId)
            end)
            print("ส่งคำสั่งเล่นเพลงไปที่ Server แล้ว: " .. musicId)
        else
            -- สำรองกรณีหาไม่เจอ เล่นเฉพาะเครื่องตัวเอง
            local sound = workspace:FindFirstChild("DeltaCustomSound") or Instance.new("Sound", workspace)
            sound.Name = "DeltaCustomSound"
            sound.SoundId = "rbxassetid://" .. musicId
            sound:Play()
            print("ไม่พบรีโมทเซิร์ฟเวอร์ เปิดฟังคนเดียวแทน")
        end
    end
end)

-- ปุ่มกดหยุด
stopButton.MouseButton1Click:Connect(function()
    local remote = getBoomboxRemote()
    if remote then
        pcall(function()
            remote:FireServer("Stop")
        end)
    end
    local sound = workspace:FindFirstChild("DeltaCustomSound")
    if sound then
        sound:Stop()
    end
end)
